{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "",
  "devCommand": "",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/services/:slug",
      "destination": "/"
    },
    {
      "source": "/services",
      "destination": "/"
    },
    {
      "source": "/how",
      "destination": "/"
    },
    {
      "source": "/demos",
      "destination": "/"
    },
    {
      "source": "/blog",
      "destination": "/"
    },
    {
      "source": "/faq",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/pricing",
      "destination": "/"
    },
    {
      "source": "/pricing/:slug",
      "destination": "/"
    },
    {
      "source": "/about",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/zeroadmin/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
